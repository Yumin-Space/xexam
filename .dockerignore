# Keep these out of the image build context: personal data, build artifacts, the repository, docs.
# The three READMEs stay in: the nginx image build reads their changelogs for the About page.
**/data
**/progress.json
**/*.xlsx
**/*.xls
**/*.db
**/*.db-journal
**/*.sqlite*
**/node_modules
**/dist
**/target
**/.vite
.claude
**/.env
**/.env.*
.git
docker-compose.yml
docker-compose.build.yml
.dockerignore
.github
docs
scripts
tests
