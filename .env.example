# 复制成 .env 再改。.env 不会被提交，也不会进镜像。

# 宿主机上发布的「地址:端口」。默认只有本机能连。
# 让局域网里别的机器（例如 cloudflared）连得到：0.0.0.0:8765  （必须写成 IP:端口；只写端口号 = 所有网卡）
XEXAM_BIND=127.0.0.1:8765

# 允许用哪些域名 / IP 访问，逗号、空格或分号分隔。留空 = 只允许本机。
XEXAM_ALLOWED_HOSTS=

# 反向代理把 Host 改写成源站地址时才需要：填你的公网域名（含 https://）
XEXAM_ALLOWED_ORIGINS=

# 1 = 不再检查 Host。只在前面已经有身份验证（Cloudflare Access）时使用。
XEXAM_ALLOW_ANY_HOST=0

# 上传解析的最长时间（秒）
XEXAM_PARSE_TIMEOUT_SECS=30

# 时区（数据库里的时间戳用它）
TZ=Asia/Tokyo
