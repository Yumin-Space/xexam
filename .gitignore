# Personal data: the question bank (exam questions) and study records; do not commit
data/
progress.json
*.xlsx
*.xls
*.db
*.db-journal
*.sqlite
*.sqlite3

# Exception: the test fixtures are **fictional** synthetic data (5 demo questions, edge cases, a sample library); they are committed so CI can run the comparison tests.
# The owner's own question bank / database is still ignored by the rules above. tests/baseline/fixtures contains no real content.
!tests/baseline/fixtures/
!tests/baseline/fixtures/*.xlsx
!tests/baseline/fixtures/sample.db

# Backup archives (they contain the whole database)
*.tgz
*.zip

# Local configuration (port, domain, etc.); do not commit
.env
.env.*
!.env.example

# Files produced at runtime
__pycache__/
*.pyc
.claude/
backend/target/
frontend/node_modules/
frontend/dist/

# Editor / system
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*
