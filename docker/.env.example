# Copy to .env in the same folder as docker-compose.yml (in a clone: docker/.env) and edit. .env is not committed and does not go into the image.

# The "address:port" published on the host. By default only this machine can connect.
# To let other machines on the LAN (e.g. cloudflared) connect: 0.0.0.0:8765  (must be written as IP:port; a bare port number = all network interfaces)
XEXAM_BIND=127.0.0.1:8765

# Hostnames / IPs allowed to access the app, separated by commas, spaces or semicolons. Empty = this machine only.
# The same check applies to AI Chat (the backend checks every AI request before Nginx passes it on).
XEXAM_ALLOWED_HOSTS=

# Only needed when a reverse proxy rewrites Host to the origin address: set your public domain (including https://)
XEXAM_ALLOWED_ORIGINS=

# 1 = stop checking Host. Use only when authentication (Cloudflare Access) is already in front.
XEXAM_ALLOW_ANY_HOST=0

# Maximum time for parsing an upload (seconds)
XEXAM_PARSE_TIMEOUT_SECS=30

# Time zone of the timestamps in the database. Leave it unset to follow the host's time zone (the compose file
# mounts the host's /etc/localtime). Set it only to use another zone, for example:
# TZ=UTC

# SQLite journal mode. Leave it unset: the database runs in WAL mode (faster, readers and writers do not block each other,
# no durability loss). Set it to delete only when the data volume is on unusual storage where WAL's shared-memory file is
# unreliable (a network filesystem, or a Windows folder bind-mounted into Docker Desktop):
# XEXAM_SQLITE_JOURNAL=delete

# 1 = the session cookie always gets Secure. Use it only when the page is reached over HTTPS (for example through Cloudflare
# Tunnel); leave it unset and Secure follows each request:
# XEXAM_COOKIE_SECURE=1

# The backend's log filter (what the System log page and docker compose logs backend show). Leave it unset or empty for info, or:
# XEXAM_LOG=debug

# —— AI service (ai-service) ——

# The key that encrypts the saved AI provider keys (API key, gateway key). Leave it unset: ai-service creates a random key
# file, secret.key, in its own data volume (xexam_ai_data). Set it to keep the key apart from that volume, so a copy of
# the volume alone cannot decrypt the keys: 32 bytes as 64 hex digits or as base64, for example the output of
#     openssl rand -base64 32
# Keep it safe: when it changes or is lost, the saved AI keys must be entered again in AI settings.
# XEXAM_AI_SECRET_KEY=

# The token the backend and ai-service use between them: it signs the identity statements the backend gives ai-service
# and authenticates ai-service's own calls to the backend (for example its state report every 25 s).
# Optional: leave it unset and the backend creates a random one in the link volume (xexam_link). If you set it, use at
# least 32 printable ASCII characters without spaces, for example the output of
#     openssl rand -hex 32
# and the same value for both services (the compose file passes this one line to both). A set value that breaks this
# rule (too short, a space, a character outside ASCII) turns the link off, so AI Chat cannot be used and AI settings
# says that ai-service cannot connect; a log line says why.
# XEXAM_INTERNAL_TOKEN=

# The AI service's log filter (what docker compose logs ai-service shows; its lines also appear in the System log).
# Leave it unset or empty for info, or:
# XEXAM_AI_LOG=debug

# SQLite journal mode of the AI database, like XEXAM_SQLITE_JOURNAL above; leave it unset (WAL), or:
# XEXAM_AI_SQLITE_JOURNAL=delete
