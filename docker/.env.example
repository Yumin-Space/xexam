# Copy to .env in the same folder as docker-compose.yml (in a clone: docker/.env) and edit. .env is not committed and does not go into the image.

# The "address:port" published on the host. By default only this machine can connect.
# To let other machines on the LAN (e.g. cloudflared) connect: 0.0.0.0:8765  (must be written as IP:port; a bare port number = all network interfaces)
XEXAM_BIND=127.0.0.1:8765

# Hostnames / IPs allowed to access the app, separated by commas, spaces or semicolons. Empty = this machine only.
XEXAM_ALLOWED_HOSTS=

# Only needed when a reverse proxy rewrites Host to the origin address: set your public domain (including https://)
XEXAM_ALLOWED_ORIGINS=

# 1 = stop checking Host. Use only when authentication (Cloudflare Access) is already in front.
XEXAM_ALLOW_ANY_HOST=0

# Maximum time for parsing an upload (seconds)
XEXAM_PARSE_TIMEOUT_SECS=30

# Time zone of the timestamps in the database. Leave it unset to follow the host's time zone (the compose file
# mounts the host's /etc/localtime). Set it only to use another zone, for example:
# TZ=UTC

# SQLite journal mode. Leave it unset: the database runs in WAL mode (faster, readers and writers do not block each other,
# no durability loss). Set it to delete only when the data volume is on unusual storage where WAL's shared-memory file is
# unreliable (a network filesystem, or a Windows folder bind-mounted into Docker Desktop):
# XEXAM_SQLITE_JOURNAL=delete

# 1 = the session cookie always gets Secure. Use it only when the page is reached over HTTPS (for example through Cloudflare
# Tunnel); leave it unset and Secure follows each request:
# XEXAM_COOKIE_SECURE=1

# The backend's log filter (what the System log page and docker compose logs backend show). Leave it unset for info, or:
# XEXAM_LOG=debug
