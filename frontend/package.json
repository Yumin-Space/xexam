{
  "name": "xexam-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Xexam front end (TypeScript + Vite, native DOM)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/domain/*.test.ts src/state/*.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "@types/node": "^24.0.0"
  }
}
